Процедура Проверка(Первое, Второе)
    Если Первое Тогда
#Если Сервер Тогда
        Пока Второе Цикл
            Попытка
                Если Первое Тогда
                    Если Второе Тогда
                        Сообщить(Первое);
                    КонецЕсли;
                КонецЕсли;
            Исключение
            КонецПопытки;
        КонецЦикла;
#Иначе
        Если Второе Тогда
            Сообщить(Второе);
        КонецЕсли;
#КонецЕсли
    КонецЕсли;
КонецПроцедуры
