// Чистый модуль: поля табличного документа ненулевые (АПК_00576, apk-00576-zero-document-fields).
// Ожидается 0 замечаний.

#Область ПрограммныйИнтерфейс

// Печатает документ с достаточными полями.
Процедура ПечатьДокумента(ТабДок, Данные) Экспорт
	
	ТабДок.ПолеСлева = 10;
	ТабДок.ПолеСверху = 20;
	ТабДок.ПолеСправа = 10;
	ТабДок.ПолеСнизу = 20;
	
	Если ТабДок.ПолеСлева < 5 Тогда
		ТабДок.BottomMargin = 15;
	КонецЕсли;
	
КонецПроцедуры

// Похожие по смыслу имена, но не нулевые поля.
Процедура ПечатьСОтступами(Document, Data) Экспорт
	
	Document.LeftMargin = 15;
	Document.TopMargin = 100;
	
КонецПроцедуры

#КонецОбласти
