Процедура Проверка(А, Б, В, Объект)
    Результат = (Не А) = (Не А);
    Результат = -А = +А;
    Результат = Метод(А + Б) = метод(Б + А);
    Результат = Метод("ABC") = Метод("abc");
    Результат = Метод(Объект.Поле) = Метод(Объект.Поле);
    Результат = А Или Б Или А;
    Результат = А И Б И А;
    Результат = А Или Б Или В Или А;
    Результат = 60 / "60";
    Результат = (60) / (60);
    Результат = "60" / "60";
    Результат = Метод(, А) = Метод(, А);
