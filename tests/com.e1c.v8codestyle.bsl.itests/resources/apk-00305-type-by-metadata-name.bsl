// Определение типа по имени метаданных — ожидается 4 замечания
// (строки 6, 10, 14, 18): = и <>, Имя и ПолноеИмя(), литерал слева и справа.

Процедура ПроверитьТипы(Ссылка) Экспорт
	
	Если Ссылка.Метаданные().Имя = "ПоступлениеТоваровУслуг" Тогда
		Флаг = Истина;
	КонецЕсли;
	
	Если Ссылка.Метаданные().Имя <> "РеализацияТоваровУслуг" Тогда
		Флаг = Ложь;
	КонецЕсли;
	
	Если Ссылка.Метаданные().ПолноеИмя() = "Документ.ПоступлениеТоваровУслуг" Тогда
		Флаг = Истина;
	КонецЕсли;
	
	Если "Номенклатура" = Ссылка.Метаданные().Имя Тогда
		Флаг = Ложь;
	КонецЕсли;
	
КонецПроцедуры
