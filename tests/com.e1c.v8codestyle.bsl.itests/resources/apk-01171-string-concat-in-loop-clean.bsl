// Без аккумуляции строк в циклах

Процедура ЧисловыеСчетчики() Экспорт

	Счетчик = 0;
	Для Номер = 1 По 10 Цикл
		Счетчик = Счетчик + 1;
	КонецЦикла;

КонецПроцедуры

Процедура СтрокиБезАккумуляции() Экспорт

	ЧастьСтроки = "";
	Для Номер = 1 По 10 Цикл
		ЧастьСтроки = "значение " + Номер;
	КонецЦикла;
	Текст = ЧастьСтроки + ";";

КонецПроцедуры
