Функция Пример1(ТипКласса)
    Если ТипКласса.Неизвестен() Тогда
        Возврат Символы.НеизвестныйСимвол;
    КонецЕсли;
    НеизвестностьНайдена = Ложь;
    СписокСимволов = ТипКласса.ПолучитьСимвол().Потомки.Поиск("имя");
    Для Каждого Символ Из СписокСимволов Цикл
        Если Символ.ИмеетТип(Символы.Странное) И НЕ Символы.Экспортный() Тогда
            Если МожноПереопределить(Символ) Тогда
                Переопределяемость = ПроверитьПереопределяемость(Символ, ТипКласса);
                Если Переопределяемость = Неопределено Тогда
                    Если НЕ НеизвестностьНайдена Тогда
                        НеизвестностьНайдена = Истина;
                    КонецЕсли;
                ИначеЕсли Переопределяемость Тогда
                    Возврат Символ;
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Если НеизвестностьНайдена Тогда
        Возврат Символы.НеизвестныйСимвол;
    КонецЕсли;
    Возврат Неопределено;
КонецФункции

Процедура Пример2(Знач Запись, Знач Транзакция)
    ИндексТранзакции = ПолучитьИндексТранзакции();
    Пока Истина Цикл
        Попытка
            Если Первый <> Неопределено Тогда
                Если Первый.ПолучитьВерсию() > Запись.ПолучитьВерсию() Тогда
                    ВызватьИсключение "Откат";
                КонецЕсли;
                Если Транзакция.Активна() Тогда
                    сч = Первый;
                    Пока сч <> Неопределено Цикл
                        Версия = сч.ПолучитьВерсию();
                        Зависимости = ПолучитьЗависимости(Версия, Транзакция.СтатусТранзакции(), 0);
                        Если (Зависимости = Неопределено) Тогда
                            ВызватьИсключение "Повторить попытку";
                        КонецЕсли;
                        Если Зависимости.Количество() <> 0 И НЕ ЕстьРекурсивныеЗависимости(Зависимости) Тогда
                            ВызватьИсключение "Откат";
                        КонецЕсли;
                    КонецЦикла;
                    сч = сч.ПолучитьПредыдущий();
                КонецЕсли;
            КонецЕсли;
            Запись.УстановитьПредыдущий(Первый);
            Первый = Запись;
            Прервать;
        Исключение
            Попытка
                Зависимости = ПолучитьЗависимости(Версия, Транзакция.СтатусТранзакции(), МаксимальноеВремяОжидания());
                Если Зависимости.Количество() <> 0 И НЕ ЕстьРекурсивныеЗависимости(Зависимости) Тогда
                    ВызватьИсключение "Откат";
                КонецЕсли;
            Исключение
                ВызватьИсключение;
            КонецПопытки;
        КонецПопытки;
    КонецЦикла;
КонецПроцедуры

Функция ВРегулярноеВыражение(Шаблон, РазделительПути)
    ЭкранированныйРазделительПути = "\\" + РазделительПути;
    МассивСтрок = Новый Массив;
    МассивСтрок.Добавить("^");
    сч = СтрНачинаетсяС(Шаблон, "/") ИЛИ ?(Шаблон.startsWith("\\"), 1, 0);
    Пока сч < СтрДлина(Шаблон) Цикл
        Символ = Сред(Шаблон, сч, 1);
        Если (СпецСимволы.Индекс(Символ) <> -1) Тогда
            МассивСтрок.Добавить("\\");
            МассивСтрок.Добавить(Символ);
        ИначеЕсли (Символ = "*") Тогда
            Если (сч + 1 < СтрДлина(Шаблон) И Сред(Шаблон, сч + 1, 1) = "*") Тогда
                Если (сч + 2 < СтрДлина(Шаблон) И ЭтоСлэш(Сред(Шаблон, сч + 2, 1))) Тогда
                    МассивСтрок.Добавить("(?:.*");
                    МассивСтрок.Добавить(ЭкранированныйРазделительПути);
                    МассивСтрок.Добавить("|)");
                    сч = сч + 2;
                Иначе
                    МассивСтрок.Добавить(".*");
                    сч = сч + 1;
                КонецЕсли;
            Иначе
                МассивСтрок.Добавить("[^");
                МассивСтрок.Добавить(ЭкранированныйРазделительПути);
                МассивСтрок.Добавить("]*?");
            КонецЕсли;
        ИначеЕсли (Символ = "?") Тогда
            МассивСтрок.Добавить("[^");
            МассивСтрок.Добавить(ЭкранированныйРазделительПути);
            МассивСтрок.Добавить("]");
        ИначеЕсли (ЭтоСлэш(Символ)) Тогда
            МассивСтрок.Добавить(ЭкранированныйРазделительПути);
        Иначе
            МассивСтрок.Добавить(Символ);
        КонецЕсли;
        сч = сч + 1;
    КонецЦикла;
    МассивСтрок.Добавить("$");
    Возврат СтрСоединить(МассивСтрок);
КонецФункции

Процедура ПроверкаРасчетаЛогическихВыражений()
    Если А И НЕ Б И НЕ (В И С) И (Г И Д) Тогда
    КонецЕсли;
    Если (А И Д И НЕ (Б И С)) Тогда
    КонецЕсли;
    Если (А И (НЕ Б ИЛИ НЕ С) И Д) Тогда
    КонецЕсли;
    Если (А И Д И (НЕ Б ИЛИ НЕ С)) Тогда
    КонецЕсли;
    А = А И НЕ (Б) И В;
КонецПроцедуры
