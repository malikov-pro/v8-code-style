Процедура ПроверитьПовторнуюВставку(СтрокаТаблицы, ДругаяСтрока)

	Массив = Новый Массив;
	Массив.Добавить(СтрокаТаблицы);
	Массив.Добавить(СтрокаТаблицы); // ошибка: та же коллекция, то же значение, изменений нет

	Структура = Новый Структура;
	Структура.Вставить("Ключ", 1);
	Структура.Вставить("Ключ", 2); // ошибка: отслеживается ключ, как в LS

	Другая.Добавить(СтрокаТаблицы);
	Другая.Добавить(ДругаяСтрока); // не ошибка: разные значения

	Первая.Добавить(СтрокаТаблицы);
	Вторая.Добавить(СтрокаТаблицы); // не ошибка: разные коллекции

	Присваивание.Добавить(СтрокаТаблицы);
	СтрокаТаблицы = ДругаяСтрока;
	Присваивание.Добавить(СтрокаТаблицы); // не ошибка: значение переприсвоено

	Сброс.Добавить(СтрокаТаблицы);
	Сброс = Новый Массив;
	Сброс.Добавить(СтрокаТаблицы); // не ошибка: коллекция переприсвоена

	Прерывание.Добавить(СтрокаТаблицы);
	Возврат;
	Прерывание.Добавить(СтрокаТаблицы); // не ошибка: возврат между вставками

	Передача.Добавить(СтрокаТаблицы);
	Обработать(СтрокаТаблицы);
	Передача.Добавить(СтрокаТаблицы); // не ошибка: значение передано в вызов между вставками

	Список.Добавить("");
	Список.Добавить(""); // не ошибка: пустая строка не анализируется

	Пусто.Добавить(Неопределено);
	Пусто.Добавить(Неопределено); // не ошибка: Неопределено не анализируется

	Если Истина Тогда
		Ветка.Добавить(СтрокаТаблицы);
	КонецЕсли;
	Если Истина Тогда
		Ветка.Добавить(СтрокаТаблицы); // не ошибка: другая ветвь
	КонецЕсли;

	Если Истина Тогда
		Ветка2.Добавить(СтрокаТаблицы);
		Ветка2.Добавить(СтрокаТаблицы); // ошибка: обе вставки в одной ветви
	КонецЕсли;

КонецПроцедуры

Функция ЗначениеВставитьПовторно()

	Результат = Новый Массив;
	Результат.Вставить(1, "Значение");
	Результат.Вставить(1, "Другое"); // ошибка: тот же первый параметр, значение ключа не учитывается

	Возврат Результат;

КонецФункции

МассивМодуля = Новый Массив;
МассивМодуля.Добавить("Значение");
МассивМодуля.Добавить("Значение"); // ошибка: повтор на уровне модуля
