Процедура Проверка(А, Б, В, Объект, Индекс)
    Результат = (А + Б) = (Б + А);
    Результат = (А = Б) И (Б = А);
    Результат = (А И Б) = (Б И А);
    Результат = (А) = А;
    Результат = Объект.Поле = Объект.Поле;
    Результат = Объект[Индекс] = Объект[Индекс];
    Результат = (А - Б) = (Б - А);
    Результат = "ABC" = "abc";
    Результат = А И (Б И А);
    Результат = А Или (Б Или А);
    Результат = ФункцияТест(А) = функцияТест(а);
