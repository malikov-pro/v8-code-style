// Чистый модуль: соединения без подзапросов и без ПОЛНОГО, без ИЛИ,
// все поля выборки с явными псевдонимами. Ожидается 0 маркеров
// всех четырёх проверок пачки query-*.

Функция ЧистыйЗапрос() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	1 КАК Поле
	|ПОМЕСТИТЬ ВТ
	|;
	|ВЫБРАТЬ
	|	А.Поле КАК Поле
	|ИЗ ВТ КАК А
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ КАК Б
	|	ПО А.Поле = Б.Поле
	|ГДЕ А.Поле = 0";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции
