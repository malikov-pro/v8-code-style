Процедура ТаймаутИзФункции()
    Профиль = Новый ИнтернетПочтовыйПрофиль;
    Профиль.Таймаут = ПолучитьТаймаут();
КонецПроцедуры

Процедура ТаймаутИзСвойства(Настройки)
    Соединение = Новый HTTPСоединение("localhost", 80,,,, Настройки.Таймаут);
КонецПроцедуры

Процедура ПроксиСТаймаутом(Определения)
    Прокси = Новый WSПрокси(Определения, "http://localhost/", "Сервис", "Порт", Неопределено, 60);
КонецПроцедуры

Процедура ПроксиБезТаймаута(Определения)
    Прокси = Новый WSПрокси(Определения, "http://localhost/", "Сервис", "Порт", 60);
КонецПроцедуры

Процедура НазначениеДоСоздания(Соединение)
    Соединение.Таймаут = 60;
    Соединение = Новый HTTPСоединение("localhost", 80);
КонецПроцедуры

Процедура ДругаяПеременная(ДругоеСоединение)
    Соединение = Новый HTTPСоединение("localhost", 80);
    ДругоеСоединение.Таймаут = 60;
КонецПроцедуры

Процедура ВложенноеНазначение(Флаг)
    Соединение = Новый HTTPСоединение("localhost", 80);
    Если Флаг Тогда
        Соединение.Таймаут = 60;
    КонецЕсли;
КонецПроцедуры

Функция ПолучитьТаймаут()
    Возврат 60;
КонецФункции
