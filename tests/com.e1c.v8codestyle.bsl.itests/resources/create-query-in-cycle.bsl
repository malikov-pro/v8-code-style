// Модуль с нарушениями: запросы и построители, выполняемые в циклах.
// Ожидается 8 замечаний create-query-in-cycle.

Процедура ЗапросСозданДоЦикла(СписокСсылок) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоступлениеТоваровУслуг.СуммаДокумента
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг";

	Для Индекс = 0 По СписокСсылок.ВГраница() Цикл
		Запрос.УстановитьПараметр("Ссылка", СписокСсылок[Индекс]);
		РезультатЗапроса = Запрос.Выполнить();       // замечание 1
	КонецЦикла;

КонецПроцедуры

Процедура ЗапросСозданВЦикле() Экспорт

	Для Счетчик = 1 По 10 Цикл
		ЛокальныйЗапрос = Новый Запрос;
		ЛокальныйЗапрос.Текст = "ВЫБРАТЬ 1";
		Выборка = ЛокальныйЗапрос.Выполнить().Выбрать();   // замечание 2
	КонецЦикла;

КонецПроцедуры

Процедура ЗапросВЦиклеПока(СписокЗначений) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ 1";

	Пока СписокЗначений.Количество() > 0 Цикл
		РезультатЗапроса = Запрос.Выполнить();       // замечание 3
		СписокЗначений.Удалить(0);
	КонецЦикла;

КонецПроцедуры

Процедура ЗапросВПредикатеЦикла() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ 1";

	Пока Запрос.Выполнить().Пустой() Цикл   // замечание 4 — предикат вычисляется на каждой итерации
		Запрос.Текст = "ВЫБРАТЬ 2";
	КонецЦикла;

КонецПроцедуры

Процедура ЗапросВБесконечномЦикле() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ 1";

	Пока Истина Цикл
		РезультатЗапроса = Запрос.Выполнить();       // замечание 5 — «Пока Истина» не исключение
		Прервать;
	КонецЦикла;

КонецПроцедуры

Процедура ПостроителиВЦикле(ДанныеОтчета) Экспорт

	ПЗ = Новый ПостроительЗапроса;
	ПостроительОтчета = Новый ПостроительОтчета;

	Пока ДанныеОтчета.Количество() > 0 Цикл
		ПЗ.Выполнить();                              // замечание 6 — ПостроительЗапроса
		ПостроительОтчета.Выполнить();               // замечание 7 — ПостроительОтчета
		ДанныеОтчета.Удалить(0);
	КонецЦикла;

КонецПроцедуры

Процедура ВложенныеЦиклы() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ 1";

	Для НомерСтроки = 1 По 10 Цикл
		Для Каждого Элемент Из Запрос.Выполнить().Выгрузить() Цикл   // замечание 8
			Сообщить(Элемент);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры
