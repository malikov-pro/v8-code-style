// apk-01216-query-field-alias
// Ожидается 3 замечания — псевдонимы, совпадающие с именами классов объектов метаданных:
// - строка 12: КАК Справочник (рус.)
// - строка 13: КАК Документ (рус.)
// - строка 20: AS Catalog (англ.)

Процедура ПсевдонимыКлассовОбъектов() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Справочник,
	|	Номенклатура.Наименование КАК Документ
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура";
	
	ЗапросАнгл = Новый Запрос;
	ЗапросАнгл.Текст =
	"SELECT
	|	Catalog.Nomenclature.Ref AS Catalog
	|FROM
	|	Catalog.Nomenclature AS Nomenclature";
	
КонецПроцедуры
