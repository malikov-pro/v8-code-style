// Ищем задание по наименованию и включаем его напрямую через менеджер.
Процедура ВключитьЗаданиеПоНаименованию(НаименованиеЗадания) Экспорт

	Отбор = Новый Структура();
	Отбор.Вставить("Наименование", НаименованиеЗадания);
	Задания = РегламентныеЗадания.ПолучитьРегламентныеЗадания(Отбор);
	Если Задания.Количество() = 1 Тогда
		НашеЗадание = Задания[0];
		НашеЗадание.Использование = Истина;
		НашеЗадание.Записать();
	КонецЕсли;

КонецПроцедуры

