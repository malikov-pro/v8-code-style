// apk-01192-summa-in-query
// Ожидается 3 замечания — вызовы СУММА()/SUM() с числовым операндом ≠ 0:
// - строка 12: СУММА(1) — в тексте запроса (рус.)
// - строка 19: SUM(1) — в тексте запроса (англ.)
// - строка 26: СУММА(1) внутри ЕСТЬNULL(..., 0)

Процедура СуммаВместоКоличество() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(1) КАК Количество
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура";
	
	ЗапросАнгл = Новый Запрос;
	ЗапросАнгл.Текст =
	"SELECT
	|	SUM(1) AS Quantity
	|FROM
	|	Catalog.Nomenclature AS Nomenclature";
	
	ЗапросЕстьNull = Новый Запрос;
	ЗапросЕстьNull.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(1), 0) КАК Количество
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура";
	
КонецПроцедуры
