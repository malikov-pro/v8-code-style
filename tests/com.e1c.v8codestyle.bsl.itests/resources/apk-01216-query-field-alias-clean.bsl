// apk-01216-query-field-alias (clean)
// Нарушений нет: осмысленные псевдонимы; «КАК Справочник» в комментарии
// не проверяется, имена классов в источниках (Справочник.Номенклатура) — не псевдонимы.

Процедура ПсевдонимыКорректны() Экспорт
	
	// КАК Справочник — в комментарии проверка не происходит
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВсяНоменклатура.Ссылка КАК Товар,
	|	ЕСТЬNULL(ОстаткиНаСкладах.КоличествоОстаток, 0) КАК Остаток
	|ИЗ
	|	Справочник.Номенклатура КАК ВсяНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки КАК ОстаткиНаСкладах
	|		ПО ВсяНоменклатура.Ссылка = ОстаткиНаСкладах.Номенклатура";
	
КонецПроцедуры
