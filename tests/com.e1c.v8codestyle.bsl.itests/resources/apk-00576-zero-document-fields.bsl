// Примеры нарушений: нулевые поля табличного документа (АПК_00576, apk-00576-zero-document-fields).
// Ожидается 9 замечаний: строки 2, 13, 14, 15, 16, 21, 22, 23, 24 (счёт с 1).
// ТабДок.ПолеСлева = 0; — вхождение в комментарии тоже помечается (как в алгоритме АПК).

#Область ПрограммныйИнтерфейс

// Печатает документ с нулевыми полями — содержимое обрезается при печати.
Процедура ПечатьСНулевымиПолями(ТабДок, Данные) Экспорт
	
	ТабДок.ПолеСлева = 0;
	ТабДок.ПолеСверху=0;
	ТабДок.ПолеСправа = 0;
	ТабДок.ПолеСнизу = 0;
	
КонецПроцедуры

// Английские имена свойств полей.
Процедура ПечатьСНулевымиПолямиАнгл(Document, Data) Экспорт
	
	Document.LeftMargin = 0;
	Document.TopMargin = 0;
	Document.RightMargin = 0;
	Document.BottomMargin = 0;
	
КонецПроцедуры

#КонецОбласти
