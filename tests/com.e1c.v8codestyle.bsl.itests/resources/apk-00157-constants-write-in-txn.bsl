// Проверка АПК_00157: запись констант в транзакции — 3 замечания (строки 7, 17, 25).

Процедура УстановитьВТранзакции()

	НачатьТранзакцию();

	Константы.СчетчикДокументов.Установить(1);

	ЗафиксироватьТранзакцию();

КонецПроцедуры

Процедура ЗаписатьВТранзакции()

	НачатьТранзакцию();
	Значение = Константы.СчетчикДокументов.Получить() + 1;
	Константы.СчетчикДокументов.Записать(Значение);
	ЗафиксироватьТранзакцию();

КонецПроцедуры

Процедура АнглийскийСинтаксис()

	BeginTransaction();
	Constants.Counter.Set(1);
	CommitTransaction();

КонецПроцедуры

Процедура ЗаписьВнеТранзакции()

	Константы.СчетчикДокументов.Установить(1);

КонецПроцедуры
