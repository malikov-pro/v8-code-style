Процедура РазныеБлоки(КодОшибки)

	Если КодОшибки = 1 Тогда
		ЗаписатьВЖурнал(КодОшибки);
		Сообщить("Ошибка");
	ИначеЕсли КодОшибки = 2 Тогда
		ПрерватьРаботу();
	ИначеЕсли КодОшибки = 3 Тогда
		ЗаписатьВЖурнал(КодОшибки + 1);
		Сообщить("Ошибка 3");
	Иначе
		ВыполнитьПереподключение();
	КонецЕсли;

КонецПроцедуры
