// Модуль без нарушений: запросы выполняются вне циклов.

Процедура ЗапросВнеЦикла(СписокСсылок) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоступлениеТоваровУслуг.СуммаДокумента
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|ГДЕ
	|	ПоступлениеТоваровУслуг.Ссылка В (&СписокСсылок)";

	Запрос.УстановитьПараметр("СписокСсылок", СписокСсылок);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Сообщить(Выборка.СуммаДокумента);
	КонецЦикла;

КонецПроцедуры

Процедура МетодСЗапросом() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ 1";
	РезультатЗапроса = Запрос.Выполнить();
	Сообщить(РезультатЗапроса.Пустой());

КонецПроцедуры

Процедура ВызовМетодаСЗапросомВЦикле() Экспорт

	Для Счетчик = 1 По 10 Цикл
		МетодСЗапросом();
	КонецЦикла;

КонецПроцедуры

Процедура ИтераторВерхнегоУровня(МассивДанных) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ 1";

	// выражение заголовка цикла вычисляется один раз до входа в цикл
	Для Каждого Элемент Из Запрос.Выполнить().Выгрузить() Цикл
		Сообщить(Элемент);
	КонецЦикла;

КонецПроцедуры

Процедура ЦиклыБезЗапросов(МассивДанных) Экспорт

	Для Каждого Элемент Из МассивДанных Цикл
		Сообщить(Элемент);
	КонецЦикла;

	Для Индекс = 0 По МассивДанных.ВГраница() Цикл
		Сообщить(МассивДанных[Индекс]);
	КонецЦикла;

	Пока МассивДанных.Количество() > 0 Цикл
		МассивДанных.Удалить(0);
	КонецЦикла;

	Пока Истина Цикл
		Прервать;
	КонецЦикла;

КонецПроцедуры
