// Правильное определение типа: сравнение типа значения с типом.
// Сравнение имени метаданных с не-литералом не порицается — ожидается 0 замечаний.

Процедура ПроверитьТипы(Ссылка, ИмяМетаданных) Экспорт
	
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		Флаг = Истина;
	КонецЕсли;
	
	Если Ссылка.Метаданные().Имя = ИмяМетаданных Тогда
		Флаг = Ложь;
	КонецЕсли;
	
КонецПроцедуры
