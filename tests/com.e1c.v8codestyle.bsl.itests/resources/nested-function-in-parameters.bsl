Процедура ПроверитьВложенныеВызовы(Объект, Ссылка, Коллекция)

	// Вложенный вызов метода в перенесённом параметре
	Объект.Заполнить(Объект.ПолучитьЗначение(
		Ссылка));

	// Вложенный конструктор с параметрами в перенесённом параметре
	Значение = Новый Структура("Ключ", Новый Массив(
		"Элемент"));

	// Вложенная глобальная функция вне белого списка
	Значение2 = Метод(ДругаяФункция(
		"Текст"));

	// Разрешённая глобальная функция
	Объект.Заполнить(НСтр(
		"ru = 'Текст'"));

	// Всё в одной строке
	Объект.Заполнить(Коллекция, Объект.ПолучитьЗначение(Ссылка));

	// Многострочный вызов, но параметры целиком на своих строках
	Объект.Заполнить(Коллекция,
		Объект.ПолучитьЗначение(Ссылка));

	// Разрешённая функция, но внутри неё вызов вне белого списка
	Объект.Заполнить(НСтр(
		Представление(Ссылка)));

	// Конструктор с типом-выражением: ограничение порта, не анализируется
	Значение3 = Новый(Тип("Массив"),
		Ссылка);

КонецПроцедуры
