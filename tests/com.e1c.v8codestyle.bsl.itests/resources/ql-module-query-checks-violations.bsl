// Нарушения пачки query-* (ql-бандл, мост bsl-ql-hub):
// - ql-full-outer-join: ПОЛНОЕ ВНЕШНЕЕ СОЕДИНЕНИЕ (1)
// - ql-logical-or-in-join: ИЛИ в условии соединения (1)
// - ql-logical-or-in-where: ИЛИ в секции ГДЕ (1)
// - ql-assign-alias-fields: поле выборки без псевдонима (1)

Функция ПолноеСоединение() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	1 КАК Поле
	|ПОМЕСТИТЬ ВТ
	|;
	|ВЫБРАТЬ
	|	А.Поле КАК Поле
	|ИЗ ВТ КАК А
	|	ПОЛНОЕ ВНЕШНЕЕ СОЕДИНЕНИЕ ВТ КАК Б
	|	ПО А.Поле = Б.Поле";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ИлиВСоединении() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	1 КАК Поле
	|ПОМЕСТИТЬ ВТ2
	|;
	|ВЫБРАТЬ
	|	А.Поле КАК Поле
	|ИЗ ВТ2 КАК А
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ2 КАК Б
	|	ПО А.Поле = Б.Поле
	|		ИЛИ А.Поле = 0";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ИлиВГДЕ() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	1 КАК Поле
	|ПОМЕСТИТЬ ВТ3
	|;
	|ВЫБРАТЬ
	|	А.Поле КАК Поле
	|ИЗ ВТ3 КАК А
	|ГДЕ А.Поле = 0
	|	ИЛИ А.Поле = 1";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ПолеБезАлиаса() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	1
	|ПОМЕСТИТЬ ВТ4";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции
