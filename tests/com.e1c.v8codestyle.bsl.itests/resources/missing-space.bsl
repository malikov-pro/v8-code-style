Процедура БезПробелов(Знач Количество)

	Сумма = Количество+2;
	Если Сумма>3 Тогда
		Результат = Сумма*2;
	КонецЕсли;
	Список = Новый Массив;
	Список.Добавить(Сумма,Результат);

	// Унарный минус перед числом пробелов не требует
	Отрицательное = -5;
	Список.Добавить(-5);
	Плотное=-5;

	// Бинарный минус по-прежнему требует пробела слева
	Разность = 5-3;

	// Запятые внутри строкового литерала пробела не требуют
	Значения = "1,2,3";

КонецПроцедуры
