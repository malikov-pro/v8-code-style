// Массовая конкатенация строк в циклах

Процедура АккумуляцияВЦикле() Экспорт

	Текст = "";
	Для Номер = 1 По 10 Цикл
		Текст = Текст + Символы.ПС + "колонка";
	КонецЦикла;

	Пока Истина Цикл
		Текст = "значение " + Текст;
	КонецЦикла;

КонецПроцедуры

Процедура АккумуляцияВложенныйЦикл() Экспорт

	Текст = "";
	Для Номер = 1 По 10 Цикл
		Для Колонка = 1 По 5 Цикл
			Текст = Текст + "x";
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура АккумуляцияВУсловии() Экспорт

	Текст = "";
	Для Каждого Элемент Из Коллекция Цикл
		Если Элемент.Пометка Тогда
			Текст = Текст + Элемент.Имя;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
