Функция ФункцияСВозвратом(Параметр)

	Результат = 0;

	Если Параметр Тогда
		Результат = 1;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ФункцияСРаннимВыходом(Параметр)

	Если Не ЗначениеЗаполнено(Параметр) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Параметр;

КонецФункции

Процедура ПроцедураСВозвратомБезЗначения(Параметр)

	Если Не ЗначениеЗаполнено(Параметр) Тогда
		Возврат;
	КонецЕсли;

	Сообщить("Процедура");

КонецПроцедуры
