#Область ПрограммныйИнтерфейс

// Возвращает комментарий с кодом основного языка из метаданных.
Функция КомментарийСКодомЯзыка() Экспорт

	Возврат НСтр("ru = 'Комментарий к проводке'", Метаданные.ОсновнойЯзык.КодЯзыка);

КонецФункции

// Возвращает код основного языка напрямую из метаданных.
Функция КодЯзыкаИзМетаданных() Экспорт

	Возврат Метаданные.ОсновнойЯзык;

КонецФункции

// Returns the main language code via the English global property.
Функция MainLanguageDirect() Экспорт

	Возврат Metadata.MainLanguage;

КонецФункции

#КонецОбласти
