Процедура МагическиеЧисла(Знач Сумма, Второй = -2)

	Итог = Сумма * 1;
	Процент = Сумма / 100;
	НомерСтроки = Таблица[0];
	Итог = Итог + Процент + НомерСтроки;

	// Отрицательные числа: -1 разрешено списком, -0.5 и -7 — магические
	МинусОдин = -1;
	Дробное = -0.5;
	Семерка = 7;
	МинусСемь = -7;

