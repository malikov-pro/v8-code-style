Процедура Проверка(А)
    Если (А = 1) = Истина Тогда
        Сообщить(А);
    КонецЕсли;
    Если Не (А = 1) <> Ложь Тогда
        Сообщить(А);
    КонецЕсли;
    Если 1 = Истина Тогда
        Сообщить(А);
    КонецЕсли;
    Если "Истина" = Истина Тогда
        Сообщить(А);
    КонецЕсли;
    Если А = Ложь Тогда
        Сообщить(А);
    КонецЕсли;
    Смешанное = ?(А, Истина, Неопределено);
    Если Смешанное = Ложь Тогда
        Сообщить(А);
    КонецЕсли;
КонецПроцедуры
