// Нарушающий модуль: 8 замечаний up-1068-unreachable-code.
// 1) тело метода после Возврат; 2) тело метода после ВызватьИсключение;
// 3) после Возврат со значением; 4) тело метода после Возврат (цикл — чистый:
//    после Продолжить лайт-версия не ловит); 5) уровень 2 — все ветви
//    Если/ИначеЕсли/Иначе завершаются возвратом/исключением;
// 6) уровень 2 — вложенное полностью терминальное Если;
// 7) блок Попытки; 8) блок Исключения.

Процедура КодПослеВозврата()
	Возврат;
	Сообщить("Недостижимо");
КонецПроцедуры

Процедура КодПослеИсключения()
	ВызватьИсключение "Ошибка";
	Сообщить("Недостижимо");
КонецПроцедуры

Функция ПослеВозвратаЗначения()
	Возврат 1;
	Сообщить("Недостижимо");
КонецФункции

Процедура ПослеВозвратаРядомСЦиклом()
	Для Ном = 1 По 10 Цикл
		Продолжить;
		Сообщить("Тоже недостижимо, но вне рамок лайт-версии");
	КонецЦикла;
	Возврат;
	Сообщить("Недостижимо");
КонецПроцедуры

Функция ВсеВетвиЗавершаются(Флаг)
	Если Флаг = 1 Тогда
		Возврат 1;
	ИначеЕсли Флаг = 2 Тогда
		Возврат 2;
	Иначе
		ВызватьИсключение "Ошибка";
	КонецЕсли;
	Сообщить("Недостижимо");
КонецФункции

Функция ВложенныеВетвиЗавершаются(Флаг)
	Если Флаг Тогда
		Если Флаг > 0 Тогда
			Возврат 1;
		Иначе
			ВызватьИсключение "Ошибка";
		КонецЕсли;
	Иначе
		Возврат 0;
	КонецЕсли;
	Сообщить("Недостижимо");
КонецФункции

Процедура НедостижимоеВПопытке()
	Попытка
		ВызватьИсключение "Ошибка";
		Сообщить("Недостижимо");
	Исключение
		Возврат;
		Сообщить("Недостижимо");
	КонецПопытки;
КонецПроцедуры
