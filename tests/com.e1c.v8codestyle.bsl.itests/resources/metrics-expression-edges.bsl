Процедура Аргументы(А, Б, В, Г)
    Сообщить(А И Б И В);
    Результат = Новый Структура("Флаг", А И Б И В);
    Результат = ?(А, ?(Б, 1, 2), 3);
КонецПроцедуры

Процедура РекурсияСАргументом(А, Б, В)
    РекурсияСАргументом(А И Б И В);
КонецПроцедуры

Процедура Переход()
    Перейти ~Метка;
    ~Метка: ;
КонецПроцедуры

Процедура ОтрицаниеРазделяет(А, Б, В, Г, Д)
    Если А И НЕ (Б И В) И Г И Д Тогда
    КонецЕсли;
КонецПроцедуры
