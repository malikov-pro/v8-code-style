Процедура Исследование(А, Б, Сумма, Признак, ОбменДанными)
    Результат = Не Сумма <> 0;
    Результат = Не (Сумма <> 0);
    Результат = Не (Не Признак);
    Результат = Не (А <> 0 И Б = 5);
    Результат = Не (Не А И Б);
    Результат = Не А <> 0 И Б = 5;
    Результат = Не А = Неопределено;
    Результат = Not (А <> 0 Or Not Б <> 1);
    Результат = Не Проверить(А, "Не Не Б <> 0");
    Если Не ОбменДанными.Загрузка Тогда
        Результат = 1;
    КонецЕсли;
    Пока Не А <> 0 Цикл
        Прервать;
    КонецЦикла;
    Если Не Сумма <> 0 Тогда
        Результат = 1;
    КонецЕсли;
    // Не Не А <> Б — только комментарий.
КонецПроцедуры

Функция Проверить(Значение, Текст)
    Возврат Значение;
КонецФункции
