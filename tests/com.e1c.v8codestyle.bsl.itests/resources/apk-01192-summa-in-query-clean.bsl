// apk-01192-summa-in-query (clean)
// Нарушений нет: КОЛИЧЕСТВО вместо СУММА(1); СУММА(0), СУММА(Поле) и
// СУММА(ВЫБОР … КОНЕЦ) не фиксируются, как в исходном алгоритме АПК.

Процедура СуммаКорректно() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество,
	|	СУММА(ВЫБОР
	|		КОГДА Номенклатура.ЭтоГруппа
	|			ТОГДА ВЫРАЗИТЬ(1 КАК ЧИСЛО(17, 0))
	|		ИНАЧЕ 0
	|	КОНЕЦ) КАК КоличествоГрупп
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура";
	
	ЗапросБезНарушений = Новый Запрос;
	ЗапросБезНарушений.Текст =
	"ВЫБРАТЬ
	|	СУММА(0) КАК Ноль,
	|	СУММА(Номенклатура.Количество) КАК Всего
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура";
	
КонецПроцедуры
