Процедура Свойства(Объект, А)
    Объект.ШаблонА = "%1 %2";
    Объект.ШаблонБ = "%1";
    Результат = СтрШаблон(Объект.ШаблонА, А);
    Результат = СтрШаблон(Объект.ШаблонБ, А);
КонецПроцедуры

Процедура ГраницаВетвей(А, Флаг)
    Если Флаг Тогда
        Шаблон = "%1 %2";
    Иначе
        Результат = СтрШаблон(Шаблон, А);
    КонецЕсли;
КонецПроцедуры

Процедура Проценты(А)
    Результат = СтрШаблон("%%11");
    Результат = СтрШаблон("%%1", А);
    Результат = СтрШаблон("%%%(1)", А);
    Результат = СтрШаблон("%(0)", А);
    Результат = СтрШаблон("%1", А, А);
КонецПроцедуры

Процедура МногострочныйШаблон(А)
    Результат = СтрШаблон("Первая %1
        |Вторая %2", А);
КонецПроцедуры

Процедура ШаблонНСтр(А)
    Локализованный = "ru='%1 %2';en='%1 %2'";
    Результат = СтрШаблон(НСтр(Локализованный), А);
КонецПроцедуры
