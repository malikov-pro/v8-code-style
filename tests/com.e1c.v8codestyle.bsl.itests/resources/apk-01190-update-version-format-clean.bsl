#Область ОбновлениеВерсииИБ

// Добавляет обработчики обновления ИБ: все версии корректны.
Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт

	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "*";
	Обработчик.Процедура = "ОбновлениеВерсииИБ.ПервоначальноеЗаполнение";
	Обработчик.НачальноеЗаполнение = Истина;

	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "2.1.3.1";
	Обработчик.Процедура = "ОбновлениеВерсииИБ.ОбновлениеВерсии2131";

	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "2.0.1.5";
	Обработчик.Процедура = "ОбновлениеВерсииИБ.ОбновлениеВерсии2015";

	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "3.0.2";
	Обработчик.Процедура = "ОбновлениеВерсииИБ.ОбновлениеВерсии302";

КонецПроцедуры

// Служебная процедура другого назначения.
Процедура ЗаполнитьОписаниеОбработчика(Обработчик)

	Обработчик.Версия = "1.1";
	Обработчик.Комментарий = "Служебный обработчик отчёта";

КонецПроцедуры

#КонецОбласти
