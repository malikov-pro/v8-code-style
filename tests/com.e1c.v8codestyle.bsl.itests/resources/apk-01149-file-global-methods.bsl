#Область ПрограммныйИнтерфейс

// Загружает файл с клиента во временное хранилище глобальными методами.
Процедура ЗагрузитьФайлКлиента(ИмяФайла) Экспорт

	АдресВХранилище = "";
	ПоместитьФайл(АдресВХранилище, ИмяФайла, Истина);
	Если Не ПустаяСтрока(АдресВХранилище) Тогда
		ПередатьАдресНаСервер(АдресВХранилище);
	КонецЕсли;

КонецПроцедуры

// Отправляет файл пользователю глобальным методом.
Процедура ОтправитьФайлПользователю(АдресВХранилище, ИмяФайла) Экспорт

	ПолучитьФайл(АдресВХранилище, ИмяФайла, Истина);

КонецПроцедуры

// Выбирает файл диалогом выбора файла с модальным вызовом «Показать».
Функция ВыбратьПутьКФайлу() Экспорт

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = НСтр("ru = 'Выберите файл'");
	Если Диалог.Показать() Тогда
		Возврат Диалог.ВыбранныеФайлы[0];
	КонецЕсли;
	Возврат "";

КонецФункции

#КонецОбласти
