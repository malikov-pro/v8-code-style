// Проверка АПК_00334: явной записи движений нет — замечаний не будет.

Процедура ОбработкаПроведения(Отказ, Проведение)

	// Записью движений управляет система при завершении проведения.
	Движения.Продажи.Записывать = Истина;
	Движения.Остатки.Прочитать();

КонецПроцедуры

Процедура ЗаписьНабораВнеПроведения()

	НаборНастроек = РегистрыСведений.Настройки.СоздатьНаборЗаписей();
	НаборНастроек.Записать();

КонецПроцедуры
