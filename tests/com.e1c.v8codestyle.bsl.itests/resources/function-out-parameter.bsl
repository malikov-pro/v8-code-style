Функция Изменение(Параметр, Знач Копия)
    Параметр = 1;
    Параметр = 2;
    Копия = 3;
    Возврат Параметр;
КонецФункции

Процедура НеФункция(Параметр)
    Параметр = 1;
КонецПроцедуры

Функция ТолькоСвойство(Объект)
    Объект.Свойство = 1;
    Возврат Объект;
КонецФункции

Функция ВложенноеПрисваивание(Параметр, Флаг)
    Если Флаг Тогда
        параметр = 1;
    КонецЕсли;
    Возврат 0;
КонецФункции
