// Нарушение: пустота результата запроса проверяется выборкой в условии.
// Ожидается 2 замечания (условия Если и Пока).

Функция ЕстьДанные(Запрос) Экспорт

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

Процедура ОбойтиВыборку(Запрос) Экспорт

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// обработка строк выборки
	КонецЦикла;

КонецПроцедуры
