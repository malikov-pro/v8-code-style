<?pde version="3.8"?><target name="1C:EDT Ruby Platform" sequenceNumber="2">
<locations>

<!-- 1C:EDT 2026.2.2: local p2 repository published from the installed runtime
     (the public ruby p2 repository for 2026.2+ no longer exists upstream;
     see WORK-2026-10-26-v8cs-cfg.md, infra incident) -->
<location includeAllPlatforms="false" includeConfigurePhase="true" includeMode="planner" includeSource="true" type="InstallableUnit">
<repository id="dt_repository" location="${env_var:EDT_P2_REPOSITORY}"/>
<unit id="com.e1c.g5.v8.dt.javadocs" version="0.0.0"/>
